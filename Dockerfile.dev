
# syntax=docker/dockerfile:1

ARG ALPINE_VERSION=3.23

# ------------------------------------------------------------
# Build stage
# ------------------------------------------------------------
FROM alpine:${ALPINE_VERSION}

RUN apk add --no-cache \
    build-base \
    cmake \
    git \
    python3 \
    pkgconf \
    sdl12-compat-dev \
    bzip2-dev \
    libjpeg-turbo-dev \
    zlib-dev \
    libgme-dev \
    openssl-dev \
    zstd-dev \
    musl-fts-dev

VOLUME /src/zandronum
